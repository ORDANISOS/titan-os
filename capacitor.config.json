{
  "appId": "com.ordanisos.app",
  "appName": "ORDANIS",
  "webDir": "dist",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0A2540",
    "scrollEnabled": true
  },
  "android": {
    "backgroundColor": "#0A2540"
  },
  "plugins": {
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    },
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#0A2540",
      "showSpinner": false,
      "launchFadeOutDuration": 300
    }
  }
}
